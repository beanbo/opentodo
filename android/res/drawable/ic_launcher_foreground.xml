<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground for the adaptive launcher icon. Sits on top of the coral
  background defined in @color/ic_launcher_background. The drawable is
  inset by 25% in ic_launcher.xml so the safe zone is roughly 72x72 dp
  inside the 108x108 dp viewport — design must stay in that region.

  Mirrors resources/icon.svg: open ring (the "O" of OpenTodo) plus a
  bold checkmark whose tail extends outward through the gap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Open ring: 270 deg arc, gap in upper-right quadrant.
         Center (54,54), radius 33.75. Start at top (54, 20.25),
         end at right (87.75, 54), large-arc, counter-clockwise. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 54,20.25 A 33.75,33.75 0 1 0 87.75,54" />

    <!-- Bold checkmark with long tail extending through the gap.
         Endpoints scaled from the 512px master (factor 108/512 ≈ 0.211). -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 33.75,52.32 L 48.95,67.96 L 93.7,16.04" />
</vector>
