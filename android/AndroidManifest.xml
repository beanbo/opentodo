<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.opentodo.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        FOREGROUND_SERVICE_DATA_SYNC is required on targetSdk 34+ when a foreground
        service uses foregroundServiceType="dataSync". The SyncService and BootReceiver
        entries that previously referenced org.opentodo.SyncService and
        org.opentodo.BootReceiver have been REMOVED (B-9.3) because those classes do
        not exist — sync runs in-process via Qt's SyncEngine, and AlarmManager-based
        reminders do not require a custom foreground service.  If a foreground sync
        service is added in the future, restore the <service> entry and ensure the
        corresponding Java class exists before re-enabling this permission.
    -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/> -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required by AlarmManager.setExactAndAllowWhileIdle() on API 31+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        Q3.24: android:name removed. Qt 5's
        org.qtproject.qt.android.bindings.QtApplication was the launcher
        Application class; that ENTIRE bindings subpackage was deleted in
        Qt 6 (see also MainActivity.java extending QtActivityBase, not the
        old bindings.QtActivity). Specifying a non-existent class as
        android:name on <application> makes Android's PackageManager fail to
        instantiate the app on launch — instant crash with no UI thread
        ever starting. Qt 6 doesn't need android:name on <application>; the
        default android.app.Application loads, and androiddeployqt's
        bootstrap inside MainActivity.onCreate() does the rest.
    -->
    <application
        android:label="OpenTodo"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true">

        <!--
            Q-Android-Audit #2.1: launcher activity is now our own subclass of
            QtActivity (android/src/org/opentodo/MainActivity.java) so we can
            override onRequestPermissionsResult and forward the
            POST_NOTIFICATIONS grant/deny back to NotificationHelper. The stock
            QtActivity does not route the result anywhere Java code can see,
            which left the permission request silently broken on API 33+.
        -->
        <activity
            android:name="org.opentodo.MainActivity"
            android:configChanges="orientation|screenSize|uiMode|screenLayout|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="OpenTodo" />
        </activity>

        <!-- BroadcastReceiver fired by AlarmManager when a scheduled notification is due -->
        <receiver
            android:name="org.opentodo.NotificationReceiver"
            android:exported="false">
        </receiver>

        <!-- Widget provider -->
        <receiver
            android:name="org.opentodo.WidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
