# ────────────────────────────────────────────────────────────────────────
# Build directories
# ────────────────────────────────────────────────────────────────────────
build/
build-*/
build-android-arm64/
build-wasm/
deploy/
dist/
out/

# CMake user files
CMakeLists.txt.user*
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Qt
*.user
*.user.*
.qmake.stash
.qtc_clangd/
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
.qt/

# Qt Creator
.qtcreator/

# VSCode
.vscode/

# JetBrains IDEs
.idea/
*.iml

# ────────────────────────────────────────────────────────────────────────
# Binaries, runtime artifacts, logs
# ────────────────────────────────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.pdb

# App runtime output
app_stdout.txt
app_stderr.txt
*.log
nlp_robust_out.txt
_testout.txt
_test_*.txt

# Crash / diagnostic dumps
*.dmp
core.*

# ────────────────────────────────────────────────────────────────────────
# Python (used by helper scripts only)
# ────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# ────────────────────────────────────────────────────────────────────────
# OS junk
# ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ────────────────────────────────────────────────────────────────────────
# Local-only documentation / drafts
# ────────────────────────────────────────────────────────────────────────
# Audit notes and review docs are kept out of the public repo by default
# (they reference internal task IDs and review iterations). Remove these
# lines if you want them tracked.
AUDIT.md
AUDIT_ITER*.md

# Personal test data / backups
Todoist backup *.zip
state-backup-*.json

# Claude-related local state (not part of the project)
.claude/

# Audit-pipeline scratch outputs (ad-hoc grep dumps, build logs etc.)
audit_*.txt
audit_*.xml
smoke_out.txt
aqt_settings.ini

# Static-analysis output (cppcheck wrapper scripts + CMake target write here).
# cppcheck_baseline.log is the captured baseline snapshot — regenerate locally
# by running tools/run-cppcheck.bat and copying cppcheck.log over the baseline.
cppcheck.log
cppcheck_baseline.log

# Compiled translation catalogues (regenerated by lrelease at build time).
# The hand-edited .ts files are tracked; their .qm output is not.
i18n/*.qm

# Intermediate JSON dumps used by tools/extract_untranslated.py and
# tools/apply_translations.py during a translation round. The .ts files
# are the source of truth; these dicts are one-shot scratch.
tools/translations_*.json
tools/untranslated.json
